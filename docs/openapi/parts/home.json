  },
  "components": {
    "schemas": {
      "HomeResponse": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "type": "string",
                "format": "date"
              },
              "nextPayday": {
                "type": "string",
                "format": "date"
              },
              "dday": {
                "type": "integer",
                "minimum": 1
              },
              "salaryState": {
                "type": "string",
                "enum": [
                  "received",
                  "needs_check",
                  "waiting",
                  "unknown"
                ],
                "description": "R12: received 인정된 급여(사용자 확인·자동 인정) 있음 · needs_check 판단 없는 후보만 있음(받음·아직으로 단정하지 않음) · waiting 후보도 없음 · unknown 실수령액 미등록"
              },
              "salaryReceivedOn": {
                "type": "string",
                "format": "date",
                "nullable": true,
                "description": "이번 회차에 인정된 급여 중 가장 이른 입금일"
              },
              "nextSalaryEarlyOn": {
                "type": "string",
                "format": "date",
                "nullable": true,
                "description": "다음 회차에 인정된 조기 급여의 입금일 (후보만 있으면 null)"
              },
              "salarySource": {
                "type": "string",
                "enum": [
                  "user",
                  "auto",
                  null
                ],
                "nullable": true,
                "description": "user 사용자 확인이 하나라도 있음 · auto 자동 인정만 · 인정된 급여가 없으면 null"
              },
              "salaryAmount": {
                "type": "integer",
                "nullable": true,
                "description": "이번 회차 인정 급여 합계 (= budget_cycle.confirmed_income)"
              },
              "salaryCheckCount": {
                "type": "integer",
                "minimum": 0,
                "description": "인정된 급여가 없는 구간의 확인 필요 후보 수"
              },
              "salaryGap": {
                "type": "object",
                "nullable": true,
                "description": "11/13. 받은 월급이 등록 실수령액과 1만원 이상 · 3% 이상 다르고 아직 그 금액으로 답하지 않았으면 채운다. 답하기: POST /api/budgets/salary/gap/ (docs/api/salary.md)",
                "properties": {
                  "diff": {
                    "type": "integer",
                    "description": "받은 - 등록 (원, 음수 = 적게)"
                  },
                  "received": {
                    "type": "integer",
                    "description": "이번 회차 인정된 월급 합계"
                  },
                  "registered": {
                    "type": "integer",
                    "description": "등록 실수령액"
                  },
                  "basis": {
                    "type": "integer",
                    "nullable": true,
                    "description": "지금 이 주기 예산 기준 금액 (apply로 정했으면)"
                  }
                },
                "required": [
                  "diff",
                  "received",
                  "registered",
                  "basis"
                ]
              }
            },
            "required": [
              "startDate",
              "endDate",
              "nextPayday",
              "dday",
              "salaryState",
              "salaryReceivedOn",
              "nextSalaryEarlyOn",
              "salarySource",
              "salaryAmount",
              "salaryCheckCount",
              "salaryGap"
            ],
            "nullable": true,
            "description": "설정한 급여일 기준. 없는 날짜는 말일. 급여일 미입력 시 null. 실제 입금 시각은 주기를 바꾸지 않는다."
          },
          "balance": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "nullable": true,
                "description": "잔액을 아는 대상 계좌 합계. 대상이 없거나 전부 미수집이면 null. 0원으로 대체하지 않는다."
              },
              "accountCount": {
                "type": "integer",
                "minimum": 0
              },
              "unknownCount": {
                "type": "integer",
                "minimum": 0
              },
              "reloginCount": {
                "type": "integer",
                "minimum": 0
              },
              "asOf": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "description": "합계에 포함된 계좌 중 가장 오래된 정상 조회 시각."
              }
            },
            "required": [
              "total",
              "accountCount",
              "unknownCount",
              "reloginCount",
              "asOf"
            ]
          },
          "pendingCount": {
            "type": "integer",
            "minimum": 0,
            "description": "전체 기간 UNCLASSIFIED 소비 거래 수. 거래 목록의 summary.needsReviewCount와 같다."
          },
          "cushionNotices": {
            "type": "object",
            "properties": {
              "depositDue": {
                "type": "boolean",
                "description": "설정한 월급날의 다음 날이면 참"
              },
              "balanceLow": {
                "type": "boolean",
                "description": "연결된 원화 통장의 잔액을 모두 확인할 수 있고 합계가 머니쿠션 추정액보다 적을 때 참"
              }
            },
            "required": [
              "depositDue",
              "balanceLow"
            ]
          },
          "needsPaydayCount": {
            "type": "integer",
            "minimum": 0,
            "description": "출금일 없는 confirmed 고정지출 수."
          },
          "mustPay": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HomePaymentDue"
            }
          },
          "budget": {
            "type": "object",
            "nullable": true,
            "description": "이번 주기 승인 예산. 수입·고정비·보호 조건을 충족하면 평소 예산의 배정액을 자동으로 이어 쓴다. 없으면 null",
            "properties": {
              "budgetId": {
                "type": "string",
                "format": "uuid"
              },
              "versionNo": {
                "type": "integer"
              },
              "livingBudget": {
                "type": "integer",
                "description": "승인 생활비"
              },
              "livingLeft": {
                "type": "integer",
                "description": "남은 생활비 (0 미만 없음)"
              },
              "livingSpent": {
                "type": "integer",
                "description": "11/17. 이번 주기 생활비 사용액 (생활비를 넘어도 그대로)"
              },
              "livingPct": {
                "type": "integer",
                "description": "사용률 % 반올림, 100 초과 가능"
              },
              "spare": {
                "type": "integer",
                "description": "남은 여윳돈"
              },
              "daily": {
                "type": "integer",
                "nullable": true,
                "description": "livingLeft ÷ daysLeft 버림. 마지막 날 null"
              },
              "daysLeft": {
                "type": "integer",
                "description": "다음 월급날 − 오늘 − 1"
              },
              "outOfBudgetAllocated": {
                "type": "integer",
                "description": "이전 기준 예산의 주거·통신·여행·숙박 배정 합계 (N-F1). 0보다 크면 재추천 안내"
              },
              "bigSpendings": {
                "type": "array",
                "description": "실제 사용액이 생활비 예산 이내인 상태에서, 주기 말 예상 지출을 예산 이내에서 5% 이상 초과로 바꾼 이번 주기 생활비 결제. 해당 결제를 뺀 하루 평균을 기준으로 예측한 뒤 순 결제액을 한 번 더한다. 최신순",
                "items": {
                  "type": "object",
                  "properties": {
                    "transactionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "occurredOn": {
                      "type": "string",
                      "format": "date"
                    },
                    "merchantName": {
                      "type": "string",
                      "description": "카드 = 가맹점명, 계좌 = 적요. 없으면 빈 문자"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "취소분을 뺀 금액"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "spending"
                      ]
                    },
                    "category": {
                      "type": "string",
                      "nullable": true,
                      "description": "소비의 카테고리 코드"
                    },
                    "categoryName": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "transactionId",
                    "occurredOn",
                    "merchantName",
                    "amount",
                    "kind",
                    "category",
                    "categoryName"
                  ]
                }
              },
              "nag": {
                "type": "string",
                "nullable": true,
                "description": "11/13. 이번 주기에 예산을 자주 바꾸면 홈 종 알림 문구 (예산 화면 nag 와 같은 값). 없으면 null"
              },
              "overCategories": {
                "type": "array",
                "description": "예산을 넘긴 카테고리 (홈 알림 줄). 쓴 돈이 배정을 넘은 카테고리만, 배정 0원은 제외. 많이 넘긴 순",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string"
                    },
                    "categoryName": {
                      "type": "string"
                    },
                    "allocated": {
                      "type": "integer",
                      "description": "배정 금액"
                    },
                    "spent": {
                      "type": "integer",
                      "description": "이번 주기에 쓴 돈"
                    },
                    "over": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "spent − allocated"
                    }
                  },
                  "required": [
                    "category",
                    "categoryName",
                    "allocated",
                    "spent",
                    "over"
                  ]
                }
              },
              "outOfBudget": {
                "type": "object",
                "description": "예산 밖 지출 안내 (계산에 안 넣음)",
                "properties": {
                  "total": {
                    "type": "integer"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "category": {
                          "type": "string",
                          "enum": [
                            "HOUSING_TELECOM",
                            "TRAVEL_LODGING"
                          ]
                        },
                        "spent": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "category",
                        "spent"
                      ]
                    }
                  }
                },
                "required": [
                  "total",
                  "categories"
                ]
              },
              "week": {
                "type": "object",
                "description": "11/17. 이번 주(월요일 시작) 몫. budget = 이번 주 전까지 쓰고 남은 생활비 ÷ 남은 주 수(올림, 최소 1)",
                "properties": {
                  "budget": {
                    "type": "integer"
                  },
                  "spent": {
                    "type": "integer"
                  },
                  "left": {
                    "type": "integer",
                    "description": "max(budget − spent, 0)"
                  }
                },
                "required": [
                  "budget",
                  "spent",
                  "left"
                ]
              },
              "forecast": {
                "type": "object",
                "nullable": true,
                "description": "11/17. 지금까지 하루 평균 × 주기 전체 일수. 주기 첫날 null",
                "properties": {
                  "total": {
                    "type": "integer"
                  },
                  "gap": {
                    "type": "integer",
                    "description": "livingBudget − total. 음수면 모자람"
                  }
                },
                "required": [
                  "total",
                  "gap"
                ]
              },
              "topCategories": {
                "type": "array",
                "description": "11/17. 이번 주기 생활비 지출 상위 3개 (지출 0원 제외)",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string"
                    },
                    "categoryName": {
                      "type": "string"
                    },
                    "spent": {
                      "type": "integer"
                    },
                    "allocated": {
                      "type": "integer"
                    },
                    "over": {
                      "type": "boolean",
                      "description": "overCategories 와 같은 기준"
                    }
                  },
                  "required": [
                    "category",
                    "categoryName",
                    "spent",
                    "allocated",
                    "over"
                  ]
                }
              },
              "vsPrev": {
                "type": "object",
                "nullable": true,
                "description": "11/17. 지난 주기 같은 기간 대비. 지난 주기 거래가 없으면 null",
                "properties": {
                  "diff": {
                    "type": "integer",
                    "description": "이번 − 지난. 양수면 더 씀"
                  }
                },
                "required": [
                  "diff"
                ]
              }
            },
            "required": [
              "budgetId",
              "versionNo",
              "livingBudget",
              "livingLeft",
              "livingSpent",
              "livingPct",
              "spare",
              "daily",
              "daysLeft",
              "outOfBudget",
              "outOfBudgetAllocated",
              "overCategories",
              "bigSpendings",
              "week",
              "forecast",
              "topCategories",
              "vsPrev"
            ]
          },
          "upcoming": {
            "type": "object",
            "description": "11/17. mustPay 중 오늘 ~ 7일 뒤에 나갈 돈",
            "properties": {
              "total": {
                "type": "integer"
              },
              "shortfall": {
                "type": "integer",
                "nullable": true,
                "description": "total − balance.total (모자랄 때만, 아니면 0). 잔액을 모르면 null"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HomePaymentDue"
                }
              }
            },
            "required": [
              "total",
              "shortfall",
              "items"
            ]
          }
        },
        "required": [
          "period",
          "balance",
          "pendingCount",
          "cushionNotices",
          "needsPaydayCount",
          "mustPay",
          "upcoming",
          "budget"
        ]
      },
      "HomePaymentDue": {
        "type": "object",
        "properties": {
          "dueId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "recurring",
              "card_bill",
              "loan"
            ]
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "description": "예정 금액에서 이미 낸 금액을 뺀 남은 금액."
          },
          "paymentState": {
            "type": "string",
            "description": "partial = 연결된 금액 합계가 예정 금액의 90%(올림) 미만. 90% 이상이면 paid라 목록에서 빠진다 (11/4).",
            "enum": [
              "unpaid",
              "partial",
              "needs_review"
            ]
          },
          "isEstimated": {
            "type": "boolean",
            "description": "card_bill의 확정 상태가 confirmed가 아니면 true. 고정지출·대출은 false."
          },
          "paymentAccount": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "format": "uuid"
              },
              "displayName": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "connected",
                  "relogin",
                  "disconnected"
                ]
              }
            },
            "required": [
              "accountId",
              "displayName",
              "status"
            ],
            "nullable": true
          },
          "userChecked": {
            "type": "boolean",
            "description": "card_bill 의 amount 가 사용자 확인 '앞으로 낼 금액'인지 (11/06). '전부 냈어요'로 확인한 청구서는 목록에서 빠진다"
          }
        },
        "required": [
          "dueId",
          "type",
          "sourceId",
          "name",
          "dueDate",
          "amount",
          "paymentState",
          "isEstimated",
          "paymentAccount",
          "userChecked"
        ]
      }
    }
  }
}
