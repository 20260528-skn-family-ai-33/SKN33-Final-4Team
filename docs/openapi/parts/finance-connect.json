                    },
                    {
                      "consentId": "a40c3432-dc91-41b7-9f5a-cf68aed0496f",
                      "purpose": "finance_inquiry",
                      "productScope": "card",
                      "documentVersion": "v1",
                      "grantedAt": "2026-10-22T10:05:00+09:00"
                    }
