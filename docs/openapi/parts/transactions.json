              {
                "$ref": "#/components/schemas/CardDisplay"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "paymentAccount": {
            "description": "계좌 거래의 계좌; 카드 승인 거래에서는 null.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccountDisplay"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
