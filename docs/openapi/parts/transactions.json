            "description": "카드 가맹점명 또는 계좌 적요."
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "description": "원거래 금액, 원."
          },
          "cancel": {
            "$ref": "#/components/schemas/TransactionCancel"
