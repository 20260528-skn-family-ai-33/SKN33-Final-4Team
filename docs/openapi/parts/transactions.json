                  "user",
                  "rule",
                  "ml",
                  "llm",
                  null
                ],
                "nullable": true,
                "description": "분류 출처. 미분류/분류 없음 null."
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "마지막 수정 시각, 한국 시간 ISO 8601."
              }
            },
            "required": [
              "installmentMonths",
              "suggestion",
              "classifiedBy",
              "updatedAt"
            ]
          }
        ]
      },
      "TransactionCategoryUpdateRequest": {
        "type": "object",
        "properties": {
          "category": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SelectableCategoryCode"
              },
              {
                "type": "string",
                "nullable": true,
                "enum": [
                  null
