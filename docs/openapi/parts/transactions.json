          "netAmount": {
            "type": "integer",
            "minimum": 0,
            "description": "amount−cancel.amount. 전체 취소면 0."
          },
          "paymentCard": {
            "description": "카드 승인 거래의 카드; 계좌 거래에서는 null.",
