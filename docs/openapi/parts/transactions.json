          "occurredOn": {
            "type": "string",
            "format": "date"
          },
          "occurredTime": {
            "type": "string",
            "nullable": true,
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "기관 거래 시각 HH:MM. 미제공 null; 같은 날 정렬 시 맨 뒤."
          },
