      "TransactionDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TransactionListItem"
          },
          {
            "type": "object",
            "properties": {
              "installmentMonths": {
                "type": "integer",
                "nullable": true,
                "minimum": 0,
                "description": "할부 개월. 일시불 0, 계좌 거래 null."
              },
              "suggestion": {
                "description": "서비스 분류 제안. 사용자 확정 후 null.",
