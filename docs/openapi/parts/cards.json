            "format": "uuid",
            "description": "선택 저장에 사용하는 내부 카드 ID."
          },
          "displayName": {
            "type": "string",
            "description": "서버가 구성한 카드명과 마스킹 번호. 끝 4자리가 없으면 번호 부분 전체 생략."
          },
          "status": {
            "type": "string",
            "enum": [
              "connected",
              "relogin"
            ],
            "description": "연결된 connection.status. disconnected 카드는 후보에서 제외."
          },
          "cardType": {
            "type": "string",
            "nullable": true,
            "description": "저장된 기관 카드 종류. 정규화 기준 미정."
          },
          "cardStatus": {
            "type": "string",
            "nullable": true,
            "description": "기관 원천 카드 상태. 연결 상태 status와 구분."
          },
          "isSelected": {
            "type": "boolean",
            "description": "현재 관리 대상으로 선택했는지 여부."
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "마지막 정상 조회 시각. 응답/선택 저장 시각으로 대체하지 않음."
          }
        },
        "required": [
          "cardId",
          "displayName",
          "status",
          "cardType",
          "cardStatus",
          "isSelected",
          "fetchedAt"
        ]
      },
      "CardCandidateList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardCandidate"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CardSelectionRequest": {
        "type": "object",
        "properties": {
          "selectedCardIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "전체 선택을 대체. 빈 배열은 전체 해제. 중복/최대 개수 정책은 미정."
          }
        },
        "required": [
          "selectedCardIds"
        ],
        "additionalProperties": false
      },
      "CardBillItem": {
        "type": "object",
        "properties": {
          "billItemId": {
            "type": "string",
            "format": "uuid"
          },
          "itemType": {
            "type": "string",
            "enum": [
              "one_time",
              "installment",
              "fee",
              "interest",
              "adjustment",
              "unknown"
            ],
            "description": "청구 항목 유형. 기관 원천값 매핑 검증 대기."
          },
          "merchantName": {
            "type": "string",
            "nullable": true
          },
          "card": {
            "description": "해당 항목의 카드. 모르면 null.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/CardDisplay"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "purchasedOn": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "원 구매일. 청구일로 대신 채우지 않음."
          },
          "originalPurchaseAmount": {
            "type": "integer",
            "nullable": true,
            "description": "전체 구매 금액, 원. 미제공은 null."
          },
          "billedAmount": {
            "type": "integer",
            "nullable": true,
            "description": "이번 회차 청구액, 원. 음수 조정액 처리 정책은 확인 필요."
          },
          "installmentMonths": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "description": "확인된 할부 총회차 1 이상. 일시불·회차 미확인은 null."
          },
          "installmentRound": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "description": "이번 회차. 1 이상이며 installmentMonths 이하. 일시불·미확인은 null."
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "해당 항목 마지막 정상 조회 시각."
          }
        },
        "required": [
          "billItemId",
          "itemType",
          "merchantName",
          "card",
          "purchasedOn",
          "originalPurchaseAmount",
          "billedAmount",
          "installmentMonths",
          "installmentRound",
          "fetchedAt"
        ]
      },
      "CardBill": {
        "type": "object",
        "properties": {
          "billId": {
            "type": "string",
            "format": "uuid"
          },
          "issuerCode": {
            "type": "string",
            "description": "카드사 코드. 예시 코드는 실제 매핑을 보증하지 않음."
          },
          "issuerName": {
            "type": "string",
            "nullable": true,
            "description": "카드사 표시 이름. 코드→이름 표가 없으면 null; 화면에서는 “카드사”."
          },
          "scopeType": {
            "type": "string",
            "enum": [
              "issuer",
              "card",
              "unknown",
              null
            ],
            "nullable": true,
            "description": "카드사 통합/단일 카드/범위 확인 불가. 저장 근거 없으면 null. card의 null 여부로 추정하지 않음."
          },
          "billingMonth": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "example": "2026-10",
            "description": "청구 월. DB 날짜(그 달 1일)에서 월까지만 응답."
          },
          "totalAmount": {
            "type": "integer",
            "description": "이번 청구서 총액, 원. 다른 소비/미납/선차감 금액으로 대신 쓰지 않음."
          },
          "confirmationStatus": {
            "type": "string",
            "enum": [
              "estimated",
              "confirmed",
              "unknown",
              null
            ],
            "nullable": true,
            "description": "예상/확정/확정 여부 확인 불가. 실제 납부 상태가 아님. 원천 값 없으면 null."
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "청구 총액·날짜의 마지막 정상 조회 시각. 상세 항목 조회 시각으로 대체하지 않음."
          },
          "paymentDueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "결제 예정일."
          },
          "withdrawalDueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "출금 예정일. 모르면 납부 예정 생성 안 함."
          },
          "paymentAccount": {
            "description": "결제 계좌를 모르면 객체 전체 null.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccountDisplay"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "card": {
            "description": "단일 연결 카드. 카드사 통합 청구에서는 null. 포함 카드 전체 없음이라는 뜻이 아님.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/CardDisplay"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardDisplay"
            },
            "nullable": true,
            "description": "포함된 것으로 확인한 카드 목록. 범위 미확인은 null, 정상 확인된 0건만 []."
          },
          "itemsState": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable",
              null
            ],
            "nullable": true,
            "description": "상세 전체 확인/일부 확인/내역 미확보. 원천 상태값이 없으면 null. 총액 확정 상태와 별개."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardBillItem"
            },
            "nullable": true,
            "description": "청구 상세. 미확보 null, 정상 확인된 0건 [], 일부면 확보분만."
          }
        },
        "required": [
          "billId",
          "issuerCode",
          "issuerName",
          "scopeType",
          "billingMonth",
          "totalAmount",
          "confirmationStatus",
          "fetchedAt",
          "paymentDueDate",
          "withdrawalDueDate",
          "paymentAccount",
          "card",
          "cards",
          "itemsState",
          "items"
        ]
      }
    }
  }
}
