{
  "paths": {
    "/api/chat/conversations/{id}/": {
      "get": {
        "operationId": "getConversation",
        "summary": "이전 대화 보기",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID. 없는 항목·남의 항목·형식 오류는 모두 404."
          }
        ],
        "description": "메시지는 오래된 순. active_agent·slots 내부 상태는 응답하지 않습니다. 화면이 기억한 conversationId로 조회하고 없거나 404이면 새 대화로 시작합니다. 대화 목록 API는 2차이며 페이지 나누기는 미정입니다.",
        "responses": {
          "200": {
