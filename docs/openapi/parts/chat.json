      "ChatMessage": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatTextMessage"
          },
          {
            "$ref": "#/components/schemas/ChatCardMessage"
          }
        ]
      },
      "ChatRouteSlots": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/ChatPeriod"
          },
          "compare": {
            "type": "string",
            "enum": [
              "prev_month"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/CategoryCode"
          },
          "amount": {
            "type": "integer"
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "description": "문장에서 뽑힌 값만 포함. 기본 집계 기간은 이번 달 1일~오늘. 이전 달 비교는 같은 일자까지, 날짜 없으면 말일까지."
      },
      "ChatSendRequest": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "choice": {
            "description": "기능 문자열 또는 최신 답변 선택지 객체. 객체 선택은 conversationId가 필요하며 turn을 검수한다.",
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "spending",
                  "budget",
                  "policy"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "turn": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "value",
                  "turn"
                ],
                "additionalProperties": false
              }
            ]
          },
          "budgetContext": {
            "$ref": "#/components/schemas/BudgetAdjustmentEntry"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "not": {
              "required": [
                "choice"
              ]
            }
          },
          {
            "required": [
              "choice"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          }
        ],
        "description": "text와 choice 중 하나. router에서 budgetContext는 choice=\"budget\"인 시작 요청과 함께만 보낸다. 직접 금액·슬롯은 보내지 않는다."
      },
      "ChatSendResponse": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "route": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "spending",
                  "budget",
                  "big",
                  "out",
                  "unknown",
                  "policy"
                ]
              },
              "slots": {
                "$ref": "#/components/schemas/ChatRouteSlots"
              },
              "fallback": {
                "type": "boolean"
              }
            },
            "required": [
              "intent",
              "slots",
              "fallback"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "task": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "succeeded",
                  "failed",
                  "canceled"
                ]
              }
            },
            "required": [
              "taskId",
              "status"
            ],
            "nullable": true
          },
          "engine": {
            "type": "string",
            "enum": [
              "legacy",
              "router"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          },
          "agent": {
            "type": "string",
            "nullable": true,
            "enum": [
              "spending",
              "budget",
              "policy",
              null
            ]
          }
        },
        "required": [
          "conversationId",
          "route",
          "messages",
          "task"
        ]
      },
      "ChatConversation": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "예: active. 전체 상태 코드는 원문에서 열거하지 않았으며 DB choices 기준."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "engine": {
            "type": "string",
            "enum": [
              "legacy",
              "router"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          }
        },
        "required": [
          "conversationId",
          "status",
          "createdAt",
          "messages"
        ]
      },
      "ChatTask": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "taskType": {
            "type": "string",
            "description": "finance_sync(수동 금융 조회), finance_auto_sync(자동 금융 조회), budget_recommend(추천 예산), budget_adjust(예산 조정) 등."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "conversationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "succeeded일 때 작업 종류별 결과. finance_sync·finance_auto_sync는 FinanceSyncResult(finance-connect.md), budget_recommend는 BudgetRecommendationResult(budgets.md)를 참조한다.",
            "x-finance-sync-schema": {
              "$ref": "#/components/schemas/FinanceSyncResult"
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "공용: server_error(서버 오류), stale(10분 넘게 멈춘 작업). 작업 종류별 추가 코드 가능."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "nullable": true
          }
        },
        "required": [
          "taskId",
          "taskType",
          "status",
          "conversationId",
          "createdAt",
          "startedAt",
          "completedAt",
          "result",
          "error"
        ]
      },
      "ChatEngineInfo": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string",
            "enum": [
              "legacy",
              "router"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          }
        },
        "required": [
          "engine",
          "features"
        ]
      },
      "BudgetAdjustmentEntry": {
        "type": "object",
        "properties": {
          "baseBudgetId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "INITIAL_ADJUSTMENT",
              "NORMAL_ADJUSTMENT",
              "DESIGN_RECOVERY"
            ]
          },
          "sourceTaskId": {
            "type": "string",
            "format": "uuid",
            "description": "분배 실패 작업 ID. DESIGN_RECOVERY에서만 사용하며 금액·설정은 서버에서 다시 조회한다."
          },
          "hints": {
            "type": "object",
            "description": "예산 화면의 초과한 카테고리에서 시작할 때만 (docs/api/chat.md). 승인 예산의 NORMAL_ADJUSTMENT에서만 보낸다. 서버는 저장하지 않고 예산 조정 에이전트에 그대로 넘긴다.",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "over"
                ]
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "생활비 배분 대상 카테고리 코드 1개 (주거·통신 · 여행·숙박 · 기타 제외)"
              },
              "overAmount": {
                "type": "integer",
                "minimum": 1,
                "description": "화면이 본 초과액. 참고값 — 서버가 최신 초과액을 다시 확인한다"
              }
            },
            "required": [
              "reason",
              "categories",
              "overAmount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "baseBudgetId"
            ],
            "not": {
              "required": [
                "sourceTaskId"
              ]
            },
            "properties": {
              "mode": {
                "enum": [
                  "INITIAL_ADJUSTMENT",
                  "NORMAL_ADJUSTMENT"
                ]
              }
            }
          },
          {
            "required": [
              "sourceTaskId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "baseBudgetId"
                  ]
                },
                {
                  "required": [
                    "hints"
                  ]
                }
              ]
            },
            "properties": {
              "mode": {
                "enum": [
                  "DESIGN_RECOVERY"
                ]
              }
            }
          }
        ],
        "description": "기존 예산 조정은 baseBudgetId, 분배 실패 조정 진입은 sourceTaskId를 보낸다. 두 ID를 동시에 보내거나 금액·최소금액·잠금·우선순위를 직접 주입할 수 없다. hints는 NORMAL_ADJUSTMENT에서만 보낸다."
      }
    }
  }
}
