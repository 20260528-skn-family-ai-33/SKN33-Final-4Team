  "components": {
    "schemas": {
      "ChatPeriod": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "ChatSpendingCategory": {
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CategoryCode"
          },
          "categoryName": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "previousAmount": {
            "type": "integer",
            "nullable": true
          },
          "ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "prevDiff": {
            "type": "integer",
            "nullable": true
          },
          "prevDiffRate": {
            "type": "number",
            "nullable": true,
            "description": "증감률은 음수·100 초과 가능. 비교 대상이 0원이면 null."
          }
        },
        "required": [
          "category",
          "categoryName",
          "amount",
          "previousAmount",
          "ratio",
          "prevDiff",
          "prevDiffRate"
        ]
      },
      "ChatSpendingCard": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "spending"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "category"
            ]
          },
          "period": {
            "$ref": "#/components/schemas/ChatPeriod"
          },
          "compare": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "nullable": true
          },
          "comparison": {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "not_requested",
                  "previous_incomplete",
                  null
                ],
                "nullable": true
              }
            },
            "required": [
              "available",
              "reason"
            ]
          },
          "total": {
            "type": "integer"
          },
          "fixedAmount": {
            "type": "integer"
          },
          "previousTotal": {
            "type": "integer",
            "nullable": true
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSpendingCategory"
            }
          },
          "topSpending": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "string",
                "enum": [
                  "category"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "$ref": "#/components/schemas/SelectableCategoryCode"
                    },
                    "categoryName": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    },
                    "ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "category",
                    "categoryName",
                    "amount",
                    "ratio"
                  ]
                }
              }
            },
            "required": [
              "basis",
              "items"
            ],
            "nullable": true
          },
          "unclassifiedAmount": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "scope",
          "period",
          "compare",
          "comparison",
          "total",
          "fixedAmount",
          "previousTotal",
          "categories",
          "topSpending",
          "unclassifiedAmount",
          "lines",
          "updatedAt"
        ],
        "description": "total·fixedAmount·previousTotal·unclassifiedAmount는 항상 전체 소비 기준. scope=category이면 categories는 해당 항목만(소비 없음은 빈 배열). 비교 불가이면 모든 비교 금액/차이/비율은 null. topSpending은 UNCLASSIFIED를 제외하고 동률 모두 포함, 단일 카테고리 또는 0원은 null. 소비가 없으면 total=0, categories=[], 0원 카드와 안내 문장을 준다. coverage는 1차에서 제외. 환불로 순소비가 음수인 경우 총액·순위·비율 표현은 미정이며 비음수 예시를 하한 정책으로 간주하지 않는다."
      },
      "ChatTextContent": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          },
          "turn": {
            "type": "integer",
            "minimum": 1
          },
          "agent": {
            "type": "string",
            "nullable": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "boolean"
          },
          "budgetAdjustment": {
            "$ref": "#/components/schemas/BudgetAdjustmentContent"
          },
          "syncedUntil": {
            "type": "array",
            "description": "소비 분석이 끝부분(오늘 쪽)만 3일 이내로 빠진 내역 기준일 때만. 빠진 계좌·카드마다 마지막으로 불러온 날. 화면은 [내역 다시 불러오기](POST /api/finance/sync/) 뒤 같은 질문을 다시 보낸다.",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "card",
                    "account"
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "표시 이름 (끝 4자리만)"
                },
                "until": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "kind",
                "name",
                "until"
              ]
            }
          }
        },
        "required": [
          "text",
          "choices"
        ]
      },
      "ChatTextMessage": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "bot"
            ]
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ChatTextContent"
          }
        },
        "required": [
          "messageId",
          "role",
          "taskId",
          "createdAt",
          "contentType",
          "content"
        ]
      },
      "ChatCardMessage": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "bot"
            ]
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "card"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ChatSpendingCard"
          }
        },
        "required": [
          "messageId",
          "role",
          "taskId",
          "createdAt",
          "contentType",
          "content"
        ]
