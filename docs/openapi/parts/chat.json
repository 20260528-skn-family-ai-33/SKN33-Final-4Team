{
  "paths": {
    "/api/chat/conversations/{id}/": {
      "get": {
        "operationId": "getConversation",
        "summary": "이전 대화 보기",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID. 없는 항목·남의 항목·형식 오류는 모두 404."
          }
        ],
        "description": "메시지는 오래된 순. active_agent·slots 내부 상태는 응답하지 않습니다. 화면이 기억한 conversationId로 조회하고 없거나 404이면 새 대화로 시작합니다. 대화 목록 API는 2차이며 페이지 나누기는 미정입니다.",
        "responses": {
          "200": {
            "description": "정상 처리",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatConversation"
                },
                "example": {
                  "conversationId": "3f2c0000-0000-4000-8000-000000000001",
                  "status": "active",
                  "createdAt": "2026-10-21T16:19:40+09:00",
                  "messages": [
                    {
                      "messageId": "a1000000-0000-4000-8000-000000000001",
                      "role": "user",
                      "contentType": "text",
                      "content": {
                        "text": "지난달보다 식비 얼마 썼어?",
                        "choices": []
                      },
                      "taskId": null,
                      "createdAt": "2026-10-21T16:19:58+09:00"
                    },
                    {
                      "messageId": "a2000000-0000-4000-8000-000000000001",
                      "role": "bot",
                      "contentType": "card",
                      "taskId": null,
                      "createdAt": "2026-10-21T16:20:00+09:00",
                      "content": {
                        "kind": "spending",
                        "scope": "category",
                        "period": {
                          "from": "2026-10-01",
                          "to": "2026-10-21"
                        },
                        "compare": {
                          "from": "2026-09-01",
                          "to": "2026-09-21"
                        },
                        "comparison": {
                          "available": true,
                          "reason": null
                        },
                        "total": 1320000,
                        "fixedAmount": 770000,
                        "previousTotal": 1250000,
                        "categories": [
                          {
                            "category": "FOOD",
                            "categoryName": "식비",
                            "amount": 420000,
                            "ratio": 32,
                            "previousAmount": 380000,
                            "prevDiff": 40000,
                            "prevDiffRate": 11
                          }
                        ],
                        "topSpending": null,
                        "unclassifiedAmount": 35000,
                        "lines": [
                          "9월 같은 기간보다 식비를 4만 원(11%) 더 썼어요."
                        ],
                        "updatedAt": "2026-10-21T16:20:00+09:00"
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "로그인 안 됨(not_authenticated) 또는 CSRF 실패(permission_denied).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
