    "/api/chat/messages/": {
      "post": {
        "operationId": "sendChatMessage",
        "summary": "챗봇에 메시지 보내기",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "description": "text와 choice 중 하나를 보낸다. 선택지 객체는 최신 {value,turn}을 검수한다. router의 budgetContext는 choice=\"budget\"과 함께 본인 기준 예산·모드를 전달한다. 예산 조정의 계산·검수·저장은 서버가 수행하고 content.budgetAdjustment로 질문·비교·변경안을 반환한다. 비교와 미리보기 선택만으로 승인하지 않는다. LLM은 대화 잠금 밖에서 호출하고, rev 검수 뒤 제안·작업·메시지를 원자 저장한다. legacy 응답 계약은 유지한다. 실제 자유 대화는 CHAT_ENGINE=router / CHAT_LLM=live 및 정책·자료 연결이 필요하다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatSendRequest"
              },
              "examples": {
                "text": {
                  "value": {
                    "conversationId": null,
                    "text": "지난달보다 식비 얼마 썼어?"
                  }
                },
                "choice": {
                  "value": {
                    "conversationId": "3f2c0000-0000-4000-8000-000000000001",
                    "choice": "spending"
                  }
                },
                "budgetDraftEntry": {
                  "value": {
                    "conversationId": null,
                    "choice": "budget",
                    "budgetContext": {
                      "baseBudgetId": "3f2c0000-0000-4000-8000-000000000001",
                      "mode": "INITIAL_ADJUSTMENT"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "정상 처리",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSendResponse"
                },
                "example": {
                  "conversationId": "3f2c0000-0000-4000-8000-000000000001",
                  "route": {
                    "intent": "spending",
                    "slots": {
                      "category": "FOOD",
                      "compare": "prev_month"
                    },
                    "fallback": false
                  },
                  "messages": [
                    {
                      "messageId": "a1000000-0000-4000-8000-000000000001",
                      "role": "user",
                      "contentType": "text",
                      "content": {
                        "text": "지난달보다 식비 얼마 썼어?",
                        "choices": []
                      },
                      "taskId": null,
                      "createdAt": "2026-10-21T16:19:58+09:00"
                    },
                    {
                      "messageId": "a2000000-0000-4000-8000-000000000001",
                      "role": "bot",
                      "contentType": "card",
                      "taskId": null,
                      "createdAt": "2026-10-21T16:20:00+09:00",
                      "content": {
                        "kind": "spending",
                        "scope": "category",
                        "period": {
                          "from": "2026-10-01",
                          "to": "2026-10-21"
                        },
                        "compare": {
                          "from": "2026-09-01",
                          "to": "2026-09-21"
                        },
                        "comparison": {
                          "available": true,
                          "reason": null
                        },
                        "total": 1320000,
                        "fixedAmount": 770000,
                        "previousTotal": 1250000,
                        "categories": [
                          {
                            "category": "FOOD",
                            "categoryName": "식비",
                            "amount": 420000,
                            "ratio": 32,
                            "previousAmount": 380000,
                            "prevDiff": 40000,
                            "prevDiffRate": 11
                          }
                        ],
                        "topSpending": null,
                        "unclassifiedAmount": 35000,
                        "lines": [
                          "9월 같은 기간보다 식비를 4만 원(11%) 더 썼어요."
                        ],
                        "updatedAt": "2026-10-21T16:20:00+09:00"
                      }
                    }
                  ],
                  "task": null
                }
              }
            }
          },
          "400": {
            "description": "입력값 오류(invalid) 또는 JSON 형식 오류(parse_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "로그인 안 됨(not_authenticated) 또는 CSRF 실패(permission_denied).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_conflict · conversation_busy · stale_choice · not_ready · expired. 충돌한 턴의 제안만 별도로 남기지 않는다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류(server_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getChatEngine",
        "summary": "챗봇 기능 버튼 보기",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "description": "저장 없이 현재 엔진과 서버가 제공하는 기능 버튼을 반환한다. router에서 예산 조정 카드를 연결하며 legacy는 이전 안내 흐름이다.",
        "responses": {
          "200": {
            "description": "엔진과 기능 버튼",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatEngineInfo"
                },
                "example": {
                  "engine": "router",
                  "features": [
                    {
                      "value": "spending",
                      "label": "소비 분석"
                    },
                    {
                      "value": "budget",
                      "label": "예산 조정"
                    },
                    {
                      "value": "policy",
                      "label": "청년 정책"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "로그인 안 됨(not_authenticated) 또는 CSRF 실패(permission_denied).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/": {
      "get": {
        "operationId": "getTask",
        "summary": "오래 걸리는 작업 진행 확인",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID. 없는 항목·남의 항목·형식 오류는 모두 404."
          }
        ],
        "description": "회원 본인의 공용 async_task를 조회한다. queued·running이면 재조회, succeeded·failed·canceled이면 중단한다. 시작 API는 1차로 요청 안에서 작업을 끝내므로 처음부터 succeeded일 수 있다. result는 succeeded일 때, error는 failed일 때만 객체이며 나머지는 null이다. finance_sync 결과는 FinanceSyncResult를 참고한다. 기관 전부 실패해도 실행을 마치면 작업은 succeeded이고 기관별 실패는 result.items[].error에 있다. 공용 실패 코드는 server_error·stale. 10분 넘게 멈춘 작업은 다음 시작 요청 때 failed/stale로 닫는다. 예산 조정안의 조건 변경은 succeeded를 바꾸지 않고 승인 단계에서 만료를 알린다. 조회 간격·최대 대기 시간·작업 취소 API는 결정 후다.",
        "responses": {
          "200": {
            "description": "정상 처리",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatTask"
                },
                "examples": {
