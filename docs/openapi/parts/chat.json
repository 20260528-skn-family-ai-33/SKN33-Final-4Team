    "/api/chat/messages/": {
      "post": {
        "operationId": "sendChatMessage",
        "summary": "챗봇에 메시지 보내기",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "description": "text와 choice 중 정확히 하나를 보냅니다. conversationId=null은 새 대화입니다. 응답 messages에는 사용자 메시지와 봇 답변 모두 포함됩니다.\n\nLLM은 문장을 해석하고 소비 숫자는 서버가 집계하며 문장은 템플릿으로 만듭니다. 라우터 실패는 200 + intent=unknown, fallback=true로 안내합니다. 선택지 요청은 fallback=false. 실패 시 기존 active_agent·slots는 유지합니다.\n\n소비는 달력월 기준이고 비교는 지난달 같은 일자까지(없는 날짜는 말일). 고정지출을 포함하고 fixedAmount로 따로 표시하며 카드값·저축·대출상환은 소비에 넣지 않습니다. 같은 구매는 한 번만 셉니다.\n\nbudget 의도는 현재 안내 글 + task=null인 기본 계약이며 실제 조정 작업 연결은 결정 후입니다. big은 3차 안내, out은 범위 안내 + 선택지입니다. 본문의 없는·남의·끝난 conversationId는 400이며 404가 아닙니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatSendRequest"
              },
              "examples": {
                "text": {
                  "value": {
                    "conversationId": null,
                    "text": "지난달보다 식비 얼마 썼어?"
                  }
                },
                "choice": {
                  "value": {
                    "conversationId": "3f2c0000-0000-4000-8000-000000000001",
                    "choice": "spending"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "정상 처리",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSendResponse"
                },
                "example": {
                  "conversationId": "3f2c0000-0000-4000-8000-000000000001",
                  "route": {
                    "intent": "spending",
                    "slots": {
                      "category": "FOOD",
                      "compare": "prev_month"
                    },
                    "fallback": false
                  },
                  "messages": [
                    {
                      "messageId": "a1000000-0000-4000-8000-000000000001",
                      "role": "user",
                      "contentType": "text",
                      "content": {
                        "text": "지난달보다 식비 얼마 썼어?",
                        "choices": []
                      },
                      "taskId": null,
                      "createdAt": "2026-10-21T16:19:58+09:00"
                    },
                    {
                      "messageId": "a2000000-0000-4000-8000-000000000001",
                      "role": "bot",
                      "contentType": "card",
                      "taskId": null,
                      "createdAt": "2026-10-21T16:20:00+09:00",
                      "content": {
                        "kind": "spending",
                        "scope": "category",
                        "period": {
                          "from": "2026-10-01",
                          "to": "2026-10-21"
                        },
                        "compare": {
                          "from": "2026-09-01",
                          "to": "2026-09-21"
                        },
                        "comparison": {
                          "available": true,
                          "reason": null
                        },
                        "total": 1320000,
                        "fixedAmount": 770000,
                        "previousTotal": 1250000,
                        "categories": [
                          {
                            "category": "FOOD",
                            "categoryName": "식비",
                            "amount": 420000,
                            "ratio": 32,
                            "previousAmount": 380000,
                            "prevDiff": 40000,
                            "prevDiffRate": 11
                          }
                        ],
                        "topSpending": null,
                        "unclassifiedAmount": 35000,
                        "lines": [
                          "9월 같은 기간보다 식비를 4만 원(11%) 더 썼어요."
                        ],
                        "updatedAt": "2026-10-21T16:20:00+09:00"
                      }
                    }
                  ],
                  "task": null
                }
              }
            }
          },
          "400": {
            "description": "입력값 오류(invalid) 또는 JSON 형식 오류(parse_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "로그인 안 됨(not_authenticated) 또는 CSRF 실패(permission_denied).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "같은 요청 번호로 다른 내용(idempotency_conflict).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류(server_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/": {
      "get": {
        "operationId": "getTask",
        "summary": "오래 걸리는 작업 진행 확인",
        "tags": [
          "통합 챗봇"
        ],
        "x-source": "docs/api/chat.md",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID. 없는 항목·남의 항목·형식 오류는 모두 404."
          }
        ],
        "description": "회원 본인의 공용 async_task를 조회한다. queued·running이면 재조회, succeeded·failed·canceled이면 중단한다. 시작 API는 1차로 요청 안에서 작업을 끝내므로 처음부터 succeeded일 수 있다. result는 succeeded일 때, error는 failed일 때만 객체이며 나머지는 null이다. finance_sync 결과는 FinanceSyncResult를 참고한다. 기관 전부 실패해도 실행을 마치면 작업은 succeeded이고 기관별 실패는 result.items[].error에 있다. 공용 실패 코드는 server_error·stale. 10분 넘게 멈춘 작업은 다음 시작 요청 때 failed/stale로 닫는다. 예산 조정안의 조건 변경은 succeeded를 바꾸지 않고 승인 단계에서 만료를 알린다. 조회 간격·최대 대기 시간·작업 취소 API는 결정 후다.",
        "responses": {
          "200": {
            "description": "정상 처리",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatTask"
                },
                "examples": {
                  "running": {
                    "value": {
                      "taskId": "d71c0000-0000-4000-8000-000000000001",
                      "taskType": "budget_adjust",
                      "status": "running",
                      "conversationId": "3f2c0000-0000-4000-8000-000000000001",
                      "createdAt": "2026-10-21T16:30:00+09:00",
                      "startedAt": "2026-10-21T16:30:01+09:00",
                      "completedAt": null,
                      "result": null,
                      "error": null
                    }
                  },
                  "financeSync": {
                    "value": {
                      "taskId": "d71c0000-0000-4000-8000-000000000001",
                      "taskType": "finance_sync",
                      "status": "succeeded",
                      "conversationId": null,
                      "createdAt": "2026-10-28T17:50:00+09:00",
                      "startedAt": "2026-10-28T17:50:00+09:00",
                      "completedAt": "2026-10-28T17:50:06+09:00",
                      "result": {
                        "summary": {
                          "total": 3,
