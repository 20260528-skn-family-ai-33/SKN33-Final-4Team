  "components": {
    "schemas": {
      "ChatPeriod": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "ChatSpendingCategory": {
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CategoryCode"
          },
          "categoryName": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "previousAmount": {
            "type": "integer",
            "nullable": true
          },
          "ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "prevDiff": {
            "type": "integer",
            "nullable": true
          },
          "prevDiffRate": {
            "type": "number",
            "nullable": true,
            "description": "증감률은 음수·100 초과 가능. 비교 대상이 0원이면 null."
          }
        },
        "required": [
          "category",
          "categoryName",
          "amount",
          "previousAmount",
          "ratio",
          "prevDiff",
          "prevDiffRate"
        ]
      },
      "ChatSpendingCard": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "spending"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "category"
            ]
          },
          "period": {
            "$ref": "#/components/schemas/ChatPeriod"
          },
          "compare": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "nullable": true
          },
          "comparison": {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "not_requested",
                  "previous_incomplete",
                  null
                ],
                "nullable": true
              }
            },
            "required": [
              "available",
              "reason"
            ]
          },
          "total": {
            "type": "integer"
          },
          "fixedAmount": {
            "type": "integer"
          },
          "previousTotal": {
            "type": "integer",
            "nullable": true
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSpendingCategory"
            }
          },
          "topSpending": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "string",
                "enum": [
                  "category"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "$ref": "#/components/schemas/SelectableCategoryCode"
                    },
                    "categoryName": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    },
                    "ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "category",
                    "categoryName",
                    "amount",
                    "ratio"
                  ]
                }
              }
            },
            "required": [
              "basis",
              "items"
            ],
            "nullable": true
          },
          "unclassifiedAmount": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "scope",
          "period",
          "compare",
          "comparison",
          "total",
          "fixedAmount",
          "previousTotal",
          "categories",
          "topSpending",
          "unclassifiedAmount",
          "lines",
          "updatedAt"
        ],
        "description": "total·fixedAmount·previousTotal·unclassifiedAmount는 항상 전체 소비 기준. scope=category이면 categories는 해당 항목만(소비 없음은 빈 배열). 비교 불가이면 모든 비교 금액/차이/비율은 null. topSpending은 UNCLASSIFIED를 제외하고 동률 모두 포함, 단일 카테고리 또는 0원은 null. 소비가 없으면 total=0, categories=[], 0원 카드와 안내 문장을 준다. coverage는 1차에서 제외. 환불로 순소비가 음수인 경우 총액·순위·비율 표현은 미정이며 비음수 예시를 하한 정책으로 간주하지 않는다."
      },
      "ChatTextContent": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          }
        },
        "required": [
          "text",
          "choices"
        ]
      },
      "ChatTextMessage": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "bot"
            ]
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ChatTextContent"
          }
        },
        "required": [
          "messageId",
          "role",
          "taskId",
          "createdAt",
          "contentType",
          "content"
        ]
      },
      "ChatCardMessage": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "bot"
            ]
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "card"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ChatSpendingCard"
          }
        },
        "required": [
          "messageId",
          "role",
          "taskId",
          "createdAt",
          "contentType",
          "content"
        ]
      },
      "ChatMessage": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatTextMessage"
          },
          {
            "$ref": "#/components/schemas/ChatCardMessage"
          }
        ]
      },
      "ChatRouteSlots": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/ChatPeriod"
          },
          "compare": {
            "type": "string",
            "enum": [
              "prev_month"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/CategoryCode"
          },
          "amount": {
            "type": "integer"
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "description": "문장에서 뽑힌 값만 포함. 기본 집계 기간은 이번 달 1일~오늘. 이전 달 비교는 같은 일자까지, 날짜 없으면 말일까지."
      },
      "ChatSendRequest": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "choice": {
            "type": "string",
            "description": "서버가 제공한 choices[].value. 모르는 값은 400. 예: spending, budget."
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "not": {
              "required": [
                "choice"
              ]
            }
          },
          {
            "required": [
              "choice"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          }
        ]
      },
      "ChatSendResponse": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "route": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "spending",
                  "budget",
                  "big",
                  "out",
                  "unknown"
                ]
              },
              "slots": {
                "$ref": "#/components/schemas/ChatRouteSlots"
              },
              "fallback": {
                "type": "boolean"
              }
            },
            "required": [
              "intent",
              "slots",
              "fallback"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "task": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "succeeded",
                  "failed",
                  "canceled"
                ]
              }
            },
            "required": [
              "taskId",
              "status"
            ],
            "nullable": true
          }
        },
        "required": [
          "conversationId",
          "route",
          "messages",
          "task"
        ]
      },
      "ChatConversation": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "예: active. 전체 상태 코드는 원문에서 열거하지 않았으며 DB choices 기준."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          }
        },
        "required": [
          "conversationId",
          "status",
          "createdAt",
          "messages"
        ]
      },
      "ChatTask": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "taskType": {
            "type": "string",
            "description": "finance_sync(수동 금융 조회), finance_auto_sync(자동 금융 조회), budget_recommend(추천 예산), budget_adjust(예산 조정) 등."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "conversationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "succeeded일 때 작업 종류별 결과. finance_sync·finance_auto_sync는 FinanceSyncResult(finance-connect.md), budget_recommend는 BudgetRecommendationResult(budgets.md)를 참조한다.",
            "x-finance-sync-schema": {
              "$ref": "#/components/schemas/FinanceSyncResult"
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "공용: server_error(서버 오류), stale(10분 넘게 멈춘 작업). 작업 종류별 추가 코드 가능."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "nullable": true
          }
        },
        "required": [
          "taskId",
          "taskType",
          "status",
          "conversationId",
          "createdAt",
          "startedAt",
          "completedAt",
          "result",
          "error"
        ]
      }
    }
  }
}
