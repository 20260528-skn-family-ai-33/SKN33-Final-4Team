{
  "paths": {
    "/api/csrf/": {
      "get": {
        "summary": "저장 전 보안값 준비",
        "operationId": "prepareCsrf",
        "tags": [
          "공통 · 인증"
        ],
        "description": "첫 저장 요청 전에 csrftoken 쿠키를 준비한다. 로그인 없이 호출할 수 있으며 요청 본문·경로 변수·쿼리는 없다. 응답 Set-Cookie로 토큰 쿠키를 설정하고 토큰 원문은 JSON 본문에 넣지 않는다. 현재 backend/config/api_common.py에 구현되어 있다.",
        "security": [],
        "x-source": "docs/api/auth.md",
        "responses": {
          "200": {
            "description": "CSRF 쿠키 준비 완료.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOk"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup/": {
      "post": {
        "summary": "회원가입",
        "operationId": "signUp",
        "tags": [
          "공통 · 인증"
        ],
        "description": "현재 미구현인 확정 API 계약이다. 회원과 필수 동의를 하나의 트랜잭션으로 저장하고 201 응답과 함께 자동 로그인 세션 쿠키를 설정한다. 로그인과 동일하게 CSRF 쿠키를 갱신한다. 동의 시각·원문 해시는 서버에서 관리한다. terms와 privacy 둘 다 필요하며 agreed·비밀번호 확인·나이·성별·급여·금융 조회 동의 등 표에 없는 필드를 보내면 400 invalid다. 이메일 정규화·DB 유일성 제약으로 중복 가입을 막고 Idempotency-Key는 사용하지 않는다. 이미 로그인한 상태의 가입 요청은 fields 없는 400 invalid다. 최종 약관 문구·원문 해시 관리, 기존 null/빈 닉네임 데이터 보완은 별도 구현·운영 조율 대상이다.",
        "security": [],
        "x-source": "docs/api/auth.md",
        "responses": {
          "201": {
            "description": "회원 생성 및 자동 로그인. onboardingCompleted는 항상 false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSignupMember"
                },
                "example": {
                  "userId": "3f2c9a10-7b63-4ec5-9a12-10c5728baf90",
                  "email": "sejin@example.com",
                  "nickname": "세진",
                  "onboardingCompleted": false
                }
              }
            }
          },
          "400": {
            "description": "입력 오류 또는 로그인 중 가입: invalid. JSON 파싱 오류: parse_error. 이메일·비밀번호·닉네임·동의 오류에는 해당 fields를 포함하고 로그인 중 가입 오류에는 fields를 생략한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "duplicateEmail": {
                    "summary": "정규화한 이메일 중복",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "email": [
                            "이미 가입된 이메일이에요"
                          ]
                        }
                      }
                    }
                  },
                  "missingConsent": {
                    "summary": "필수 동의 누락",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "consents": [
                            "서비스 약관과 개인정보 처리방침에 모두 동의해 주세요."
                          ]
                        }
                      }
                    }
                  },
                  "unknownField": {
                    "summary": "허용되지 않은 항목",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "agreed": [
                            "이 칸은 보낼 수 없어요."
                          ]
                        }
                      }
                    }
                  },
                  "alreadySignedIn": {
                    "summary": "로그인 중 가입",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "로그인한 상태에서는 회원가입할 수 없어요."
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "CSRF 쿠키·X-CSRFToken 누락 또는 불일치: permission_denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "csrf": {
                    "summary": "CSRF 검증 실패",
                    "value": {
                      "error": {
                        "code": "permission_denied",
                        "message": "요청 권한을 확인해 주세요."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "시도 횟수 초과: throttled. 가입 IP당 1시간 10번 (성공·실패 모두 셈). 기다릴 초는 Retry-After 헤더.",
            "headers": {
              "Retry-After": {
                "description": "다시 시도할 수 있을 때까지 남은 초",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "throttled": {
                    "summary": "시도 횟수 초과",
                    "value": {
                      "error": {
                        "code": "throttled",
                        "message": "시도가 너무 많아요. 잠시 후 다시 시도해 주세요."
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignupRequest"
              },
              "example": {
                "email": "sejin@example.com",
                "password": "Example123!",
                "nickname": "세진",
                "consents": [
                  {
                    "purpose": "terms",
                    "documentVersion": "v1"
                  },
                  {
                    "purpose": "privacy",
                    "documentVersion": "v1"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/auth/login/": {
      "post": {
        "summary": "로그인",
