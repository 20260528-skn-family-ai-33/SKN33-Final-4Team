{
  "paths": {
    "/api/csrf/": {
      "get": {
        "summary": "저장 전 보안값 준비",
        "operationId": "prepareCsrf",
        "tags": [
          "공통 · 인증"
        ],
        "description": "첫 저장 요청 전에 csrftoken 쿠키를 준비한다. 로그인 없이 호출할 수 있으며 요청 본문·경로 변수·쿼리는 없다. 응답 Set-Cookie로 토큰 쿠키를 설정하고 토큰 원문은 JSON 본문에 넣지 않는다. 현재 backend/config/api_common.py에 구현되어 있다.",
        "security": [],
        "x-source": "docs/api/auth.md",
        "responses": {
          "200": {
            "description": "CSRF 쿠키 준비 완료.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOk"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup/": {
      "post": {
        "summary": "회원가입",
        "operationId": "signUp",
        "tags": [
          "공통 · 인증"
        ],
        "description": "현재 미구현인 확정 API 계약이다. 회원과 필수 동의를 하나의 트랜잭션으로 저장하고 201 응답과 함께 자동 로그인 세션 쿠키를 설정한다. 로그인과 동일하게 CSRF 쿠키를 갱신한다. 동의 시각·원문 해시는 서버에서 관리한다. terms와 privacy 둘 다 필요하며 agreed·비밀번호 확인·나이·성별·급여·금융 조회 동의 등 표에 없는 필드를 보내면 400 invalid다. 이메일 정규화·DB 유일성 제약으로 중복 가입을 막고 Idempotency-Key는 사용하지 않는다. 이미 로그인한 상태의 가입 요청은 fields 없는 400 invalid다. 최종 약관 문구·원문 해시 관리, 기존 null/빈 닉네임 데이터 보완은 별도 구현·운영 조율 대상이다.",
        "security": [],
        "x-source": "docs/api/auth.md",
        "responses": {
          "201": {
            "description": "회원 생성 및 자동 로그인. onboardingCompleted는 항상 false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSignupMember"
                },
                "example": {
                  "userId": "3f2c9a10-7b63-4ec5-9a12-10c5728baf90",
                  "email": "sejin@example.com",
                  "nickname": "세진",
                  "onboardingCompleted": false
                }
              }
            }
          },
          "400": {
            "description": "입력 오류 또는 로그인 중 가입: invalid. JSON 파싱 오류: parse_error. 이메일·비밀번호·닉네임·동의 오류에는 해당 fields를 포함하고 로그인 중 가입 오류에는 fields를 생략한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "duplicateEmail": {
                    "summary": "정규화한 이메일 중복",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "email": [
                            "이미 가입된 이메일이에요"
                          ]
                        }
                      }
                    }
                  },
                  "missingConsent": {
                    "summary": "필수 동의 누락",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "consents": [
                            "서비스 약관과 개인정보 처리방침에 모두 동의해 주세요."
                          ]
                        }
                      }
                    }
                  },
                  "unknownField": {
                    "summary": "허용되지 않은 항목",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "agreed": [
                            "이 칸은 보낼 수 없어요."
                          ]
                        }
                      }
                    }
                  },
                  "alreadySignedIn": {
                    "summary": "로그인 중 가입",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "로그인한 상태에서는 회원가입할 수 없어요."
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "CSRF 쿠키·X-CSRFToken 누락 또는 불일치: permission_denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "csrf": {
                    "summary": "CSRF 검증 실패",
                    "value": {
                      "error": {
                        "code": "permission_denied",
                        "message": "요청 권한을 확인해 주세요."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignupRequest"
              },
              "example": {
                "email": "sejin@example.com",
                "password": "Example123!",
                "nickname": "세진",
                "consents": [
                  {
                    "purpose": "terms",
                    "documentVersion": "v1"
                  },
                  {
                    "purpose": "privacy",
                    "documentVersion": "v1"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/auth/login/": {
      "post": {
        "summary": "로그인",
        "operationId": "logIn",
        "tags": [
          "공통 · 인증"
        ],
        "description": "현재 미구현인 확정 API 계약이다. Django 세션 쿠키로 로그인하고 세션을 14일 유지한다. accessToken·refreshToken·JWT를 발급하거나 응답하지 않는다. 회원가입 때의 비밀번호 길이·조합 조건을 로그인에 재적용하지 않는다. 자동 로그인 요청 필드는 없고 이메일 기억하기는 화면 기능이다. 실패 횟수 제한은 1차 범위에서 제외한다. 이메일 없음·비밀번호 불일치·정지·탈퇴 계정을 동일한 400 invalid 문구로 처리하며 fields를 생략한다. 실패하면 세션을 생성하지 않는다. 로그인으로 CSRF 토큰이 바뀌면 이후 요청에는 새 쿠키 값을 사용한다. 이미 로그인한 상태에서 재로그인하는 정책은 원문에서 확인 필요로 남아 있다.",
        "security": [],
        "x-source": "docs/api/auth.md",
        "responses": {
          "200": {
            "description": "로그인 세션 생성. 첫 예산 승인 여부를 함께 반환한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMember"
                },
                "example": {
                  "userId": "3f2c9a10-7b63-4ec5-9a12-10c5728baf90",
                  "email": "sejin@example.com",
                  "nickname": "세진",
                  "onboardingCompleted": false
                }
              }
            }
          },
          "400": {
            "description": "필수 입력 누락·이메일 형식 오류 또는 인증 실패: invalid. JSON 파싱 오류: parse_error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "credentials": {
                    "summary": "자격 증명 불일치·정지·탈퇴 공통",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "이메일 또는 비밀번호를 확인해 주세요."
                      }
                    }
                  },
                  "email": {
                    "summary": "입력 칸 오류",
                    "value": {
                      "error": {
                        "code": "invalid",
                        "message": "입력값을 확인해 주세요.",
                        "fields": {
                          "email": [
                            "이메일 형식을 확인해 주세요."
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "CSRF 쿠키·X-CSRFToken 누락 또는 불일치: permission_denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "csrf": {
                    "summary": "CSRF 검증 실패",
                    "value": {
                      "error": {
                        "code": "permission_denied",
                        "message": "요청 권한을 확인해 주세요."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              },
              "example": {
                "email": "sejin@example.com",
                "password": "Example123!"
              }
            }
          }
        }
      }
    },
    "/api/auth/logout/": {
      "post": {
        "summary": "로그아웃",
        "operationId": "logOut",
        "tags": [
          "공통 · 인증"
        ],
        "description": "현재 미구현인 확정 API 계약이다. 요청 본문·회원 ID·세션 ID 없이 쿠키에 연결된 현재 세션을 종료한다. 로그인은 필수가 아니지만 CSRF는 검증한다. 유효한 CSRF 요청이면 이미 로그아웃된 상태에도 200과 {\"ok\": true}를 반환한다. 다른 기기의 모든 세션을 종료하는 기능은 포함하지 않는다. 성공 후 화면은 회원 정보를 비우고 로그인 화면으로 이동한다.",
        "security": [],
        "x-source": "docs/api/auth.md",
        "responses": {
          "200": {
            "description": "현재 세션 종료 완료 또는 이미 로그아웃된 상태.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOk"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "403": {
            "description": "CSRF 쿠키·X-CSRFToken 누락 또는 불일치: permission_denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "csrf": {
                    "summary": "CSRF 검증 실패",
                    "value": {
                      "error": {
                        "code": "permission_denied",
                        "message": "요청 권한을 확인해 주세요."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me/": {
      "get": {
        "summary": "내 계정 확인",
        "operationId": "getCurrentMember",
        "tags": [
          "공통 · 인증"
        ],
        "description": "현재 미구현인 확정 API 계약이다. 현재 세션의 로그인 여부와 기본 회원 정보를 조회한다. 요청 본문·경로 변수·쿼리는 없으며 userId를 입력받지 않는다. 정상 응답의 nickname은 null이나 빈 문자열이 될 수 없다. 기존 null/빈 닉네임 회원의 보완·전환 절차는 별도 조율 대상이다. onboardingCompleted는 첫 예산 승인 이력으로 판단하고 단계 번호는 반환하지 않는다. false면 저장된 입력값을 채운 온보딩 첫 단계로 이동한다. 비로그인·만료 세션에 가짜 회원 또는 200 빈 값을 반환하지 않는다.",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "x-source": "docs/api/auth.md",
        "responses": {
          "200": {
            "description": "현재 로그인한 회원의 기본 정보.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMember"
                },
                "example": {
                  "userId": "3f2c9a10-7b63-4ec5-9a12-10c5728baf90",
                  "email": "sejin@example.com",
                  "nickname": "세진",
                  "onboardingCompleted": false
                }
              }
            }
          },
          "403": {
            "description": "비로그인 또는 세션 만료: not_authenticated. 세션 인증은 401 대신 403을 사용한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "loginRequired": {
                    "summary": "로그인 필요",
                    "value": {
                      "error": {
                        "code": "not_authenticated",
                        "message": "로그인이 필요해요."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드: method_not_allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류: server_error. 성공으로 처리하지 않고 다시 시도한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthOk": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "요청 처리 완료. CSRF 준비 응답에서는 로그인 성공 여부를 뜻하지 않는다."
          }
        },
        "required": [
          "ok"
        ]
      },
      "AuthMember": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "서버가 생성한 회원 UUID."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "앞뒤 공백 제거 후 전체 소문자로 정규화된 이메일."
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "필수 이름(닉네임). 앞뒤 공백 제거 후 1~100자이며 공백만 있는 값도 허용하지 않는다."
          },
          "onboardingCompleted": {
            "type": "boolean",
            "description": "첫 예산 승인 이력이 있으면 true. 단순한 현재 예산 유무와 다르다. false면 기존 입력값을 채운 온보딩 첫 단계로 이동한다."
          }
        },
        "required": [
          "userId",
          "email",
          "nickname",
          "onboardingCompleted"
        ]
      },
      "AuthSignupMember": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthMember"
          },
          {
            "type": "object",
            "properties": {
              "onboardingCompleted": {
                "type": "boolean",
                "enum": [
                  false
                ],
                "description": "새로 가입한 회원이므로 항상 false."
              }
            }
          }
        ]
      },
      "AuthSignupConsent": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "terms",
              "privacy"
            ],
            "description": "필수 동의 구분."
          },
          "documentVersion": {
            "type": "string",
            "enum": [
              "v1"
            ],
            "description": "사용자가 실제 확인한 문서 버전."
          }
        },
        "required": [
          "purpose",
          "documentVersion"
        ],
        "additionalProperties": false
      },
      "AuthSignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "앞뒤 공백 제거·소문자 정규화 후 중복 검사한다."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 25,
            "description": "영문·숫자·특수문자 중 2가지 이상을 포함해야 한다. 서버도 동일하게 검사한다. 비밀번호 확인은 화면에서만 비교하며 별도 필드를 전송하지 않는다."
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "앞뒤 공백 제거 후 1~100자. null·빈 문자열·공백만 있는 값은 거절한다."
          },
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthSignupConsent"
