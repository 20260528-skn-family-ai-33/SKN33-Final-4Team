{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/moneycushion-backend",
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/moneycushion-frontend"
      ]
    }
  ]
}
