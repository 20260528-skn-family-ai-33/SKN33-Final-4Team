# 이 파일을 복사해 .env를 만들고 값을 채운다: cp .env.example .env
# .env는 Git에 올리지 않는다. 자세한 설명은 docs/ENV_SETUP.md 참고

# ===== Django =====
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== PostgreSQL =====
POSTGRES_DB=money_cushion
POSTGRES_USER=money_cushion
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== 외부 API (발급 후 입력) =====
# CODEF 데모 버전 키 (codef.io > MY > 키관리)
# CODEF_ENV: sandbox · demo · product (비우면 demo)
CODEF_ENV=demo
CODEF_CONNECTED_ID=
CODEF_DEMO_ID=여기에_데모_client_id
CODEF_DEMO_SECRET=여기에_데모_client_secret
CODEF_PUBLIC_KEY="MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...(전체를 한 줄로)"
# (선택) 카드 확인 명령어(codef_card_check --card-auth)용. 현대카드처럼 조회 때 카드 번호 · 비밀번호를 요구하는 카드사
# 실제 값은 .env 에만 적고 절대 커밋하지 않는다
CODEF_CARD_NO=
CODEF_CARD_PASSWORD=

# 공공데이터포털 (상가(상권)정보 · 복지서비스)
DATA_GO_KR_SERVICE_KEY=

# ===== OpenAI =====
# platform.openai.com > API keys (월 사용 한도 설정 권장)
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# ===== 검색 (카카오 로컬 · 네이버 지역 검색) =====
# 카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키 (팀 공용 앱 1개)
KAKAO_REST_API_KEY=
# NAVER API HUB > Application (지역 검색 선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== Jev (TypeSafe) =====
# console.typesafe.ai > API keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
