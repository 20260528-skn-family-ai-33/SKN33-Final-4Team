# 이 파일을 복사해 .env를 만들고 값을 채운다: cp .env.example .env
# .env는 Git에 올리지 않는다. 자세한 설명은 docs/ENV_SETUP.md 참고

# ===== Django =====
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== PostgreSQL =====
POSTGRES_DB=money_cushion
POSTGRES_USER=money_cushion
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== 외부 API (발급 후 입력) =====
# CODEF 데모 버전 키 (codef.io > MY > 키관리)
# CODEF_ENV: sandbox · demo · product (비우면 demo)
CODEF_ENV=demo
CODEF_CONNECTED_ID=
CODEF_DEMO_ID=여기에_데모_client_id
CODEF_DEMO_SECRET=여기에_데모_client_secret
CODEF_PUBLIC_KEY="MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...(전체를 한 줄로)"
# 회원별 connectedId 암호화 키 (32바이트, 필수). 아래 명령으로 만든 값을 넣는다
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 키 값은 단톡방 등에 올리지 않는다. 같은 DB를 같이 쓰는 사람끼리만 따로 전달 (키가 다르면 저장된 연결을 못 읽음)
CONNECTED_ID_ENCRYPTION_KEY=
# (선택) 카드 확인 명령어(codef_card_check --card-auth)용. 현대카드처럼 조회 때 카드 번호 · 비밀번호를 요구하는 카드사
# 실제 값은 .env 에만 적고 절대 커밋하지 않는다
CODEF_CARD_NO=
CODEF_CARD_PASSWORD=

# 공공데이터포털 (상가(상권)정보 · 복지서비스)
DATA_GO_KR_SERVICE_KEY=

# ===== OpenAI =====
# platform.openai.com > API keys (월 사용 한도 설정 권장)
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# ===== 챗봇 엔진 (backend/config/settings.py) =====
# legacy(기본, 기존 선택지 챗봇) | router(라우터 + 소비 분석 + 예산 조정)
CHAT_ENGINE=legacy
# fake(기본, 가짜 해석 · 네트워크 없음) | live(실제 LLM — 위 OPENAI_API_KEY · LLM_MODEL 필요)
CHAT_LLM=fake
# 감액 기본값은 그룹 내 감액 가능액 비례 배분. 실제 ML 참조 함수는 별도 연결.
BUDGET_ADJUST_ALLOCATOR=
BUDGET_ADJUST_REFERENCE_PROVIDER=
# A/B 서비스와 외부 추천을 각각 켠다. 외부 호출은 별도의 해당 기능 동의도 필요하다.
BUDGET_DESIGN_ENABLED=false
BUDGET_DESIGN_EXTERNAL_ENABLED=false

# ===== 검색 (카카오 로컬 · 네이버 지역 검색) =====
# 카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키 (팀 공용 앱 1개)
KAKAO_REST_API_KEY=
# NAVER API HUB > Application (지역 검색 · 웹문서 검색 선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== Jev (TypeSafe) =====
# console.typesafe.ai > API keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0

# ===== 예산 설계 (운영 검수 후 명시적으로 활성화) =====
BUDGET_DESIGN_ENABLED=false
# OFF일 때 새 AI 전송 동의와 외부 호출 모두 차단. 기존 동의 철회는 가능.
BUDGET_DESIGN_EXTERNAL_ENABLED=false
