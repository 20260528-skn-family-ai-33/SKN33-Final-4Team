# 이 파일을 복사해 .env를 만들고 값을 채운다: cp .env.example .env
# .env는 Git에 올리지 않는다. 자세한 설명은 docs/ENV_SETUP.md 참고

# ===== Django =====
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== PostgreSQL =====
POSTGRES_DB=money_cushion
POSTGRES_USER=money_cushion
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== 외부 API (발급 후 입력) =====
# CODEF 금융 거래 API
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CODEF_ENV=sandbox

# 공공데이터포털 (상가(상권)정보 · 복지서비스)
DATA_GO_KR_SERVICE_KEY=

# ===== 제공자 확정 후 주석 해제 =====
# LLM
# OPENAI_API_KEY=
# 검색/지도 (카카오 로컬 API 기준)
# KAKAO_REST_API_KEY=
