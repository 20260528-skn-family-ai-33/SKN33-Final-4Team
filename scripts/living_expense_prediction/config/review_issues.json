{
  "version": "v13_share",
  "issue_definitions": {
    "mixed_living": {
      "title": "생활비에 정기 지출이 섞일 가능성",
      "meaning": "현재 생활비 처리를 유지하고 정기성 확인 대상으로 표시한다."
    },
    "housing_cash_proxy": {
      "title": "현금 주거비와 다른 평가액 혼합 가능성",
      "meaning": "무상·사택·영구임대의 실제주거비. 보조 월세로 교체하지 않는다."
    },
    "category_mixed": {
      "title": "여러 용도가 섞인 카테고리 근사",
      "meaning": "원천 금액을 임의 배분하지 않는다."
    },
    "nonroutine_unverified": {
      "title": "비정기성 미확인 P95 후보",
      "meaning": "지출 빈도 대신 금액 기준으로 분리하는 기존 정책이다."
    },
    "threshold_unavailable": {
      "title": "양수 표본 부족으로 P95 미적용",
      "meaning": "임계값을 만들지 않고 전액 생활비에 남긴다."
    },
    "interest_scope": {
      "title": "대출 이자를 고정비 입력으로 포함",
      "meaning": "100번째 원천으로 기타 원지출에 포함하고 고정비로 전액 분리한다. 생활비에서 다시 차감하지 않으며 대출 원금은 포함하지 않는다."
    },
    "vehicle_missing": {
      "title": "차량 대수 원문 공백",
      "meaning": "0대와 구분하여 결측으로 보존한다."
    },
    "invalid_profile": {
      "title": "입력 또는 가중치 유효성 제외",
      "meaning": "입력·가중치·생활비 정답의 유효성을 검사한다. 행은 삭제하지 않고 제외 사유를 기록한다."
    }
  },
